# Copier vers .env.isolated (ignoré par Git), puis chmod 600.
# PostgreSQL isolé pour la production.
APP_IMAGE=baaraboloda:production
APP_PORT=18080
POSTGRES_DB=baaraboloda
POSTGRES_ADMIN_PASSWORD=
DATABASE_URL=jdbc:postgresql://postgres:5432/baaraboloda
DATABASE_USER=baaraboloda
DATABASE_PASSWORD=
JWT_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=notifications@baaraboloda.crademo.com
