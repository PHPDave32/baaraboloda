# Copiez ce fichier en ".env" sur le serveur et remplissez les valeurs.
# NE JAMAIS committer le fichier .env rempli.

# Port sur lequel l'app est exposée sur le serveur.
# - "8080:8080" via APP_PORT=8080 => accessible depuis le reseau local sur http://IP_SERVEUR:8080
# - Mettez "127.0.0.1:8080" comme valeur si vous voulez limiter au serveur uniquement (avec reverse-proxy devant).
APP_PORT=8080

# Base de donnees MySQL
MYSQL_DATABASE=baaraboloda
MYSQL_USER=baaraboloda
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# Secret JWT en base64 (256 bits minimum recommande).
# Generez-en un avec :  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me-generate-a-long-base64-secret
